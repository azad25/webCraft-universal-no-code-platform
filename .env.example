# Database Configuration
DATABASE_URL=postgresql://webcraft:password@localhost:5432/webcraft_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API Configuration
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# AI Service API Keys
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Payment Configuration (Stripe)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRO_PRICE_ID=price_your-pro-price-id
STRIPE_ENTERPRISE_PRICE_ID=price_your-enterprise-price-id

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=webcraft-assets

# Storage Configuration
STORAGE_PROVIDER=local  # local, s3, gcs, azure, cloudflare_r2
STORAGE_BUCKET=webcraft-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_ENDPOINT_URL=  # For S3-compatible services like MinIO or R2
STORAGE_LOCAL_PATH=./uploads
STORAGE_CDN_URL=  # Optional CDN URL for serving files
STORAGE_MAX_FILE_SIZE=104857600  # 100MB in bytes

# CDN Configuration
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@webcraft.dev

# Domain Configuration
DOMAIN_REGISTRAR_API_KEY=your-domain-api-key
DOMAIN_REGISTRAR_SECRET=your-domain-secret

# Deployment Configuration
VERCEL_TOKEN=your-vercel-token
NETLIFY_TOKEN=your-netlify-token
K8S_NAMESPACE=webcraft-apps
AWS_ECS_CLUSTER=webcraft-cluster

# Preview Configuration
PREVIEW_BASE_URL=http://localhost
PREVIEW_DOMAIN=preview.webcraft.local
PREVIEW_BUILDS_DIR=/tmp/webcraft-previews
PREVIEW_INSTALL_DEPS=true
PREVIEW_PORT_RANGE_START=10000
PREVIEW_PORT_RANGE_END=20000

# Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Environment
NODE_ENV=development
ENVIRONMENT=development

# Security
CORS_ORIGINS=http://localhost:3000,https://webcraft.dev
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Monitoring
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info